{
  "description": "Language codes for the Supertext AI file API. Source = bare language (\"en\"), target = regional code (\"de-DE\"). See docs/integration-guide.md → Language codes.",
  "defaultRegions": {
    "ar": "ar-SA", "bg": "bg-BG", "cs": "cs-CZ", "da": "da-DK", "de": "de-DE", "el": "el-GR",
    "en": "en-US", "es": "es-ES", "et": "et-EE", "fi": "fi-FI", "fr": "fr-FR", "hr": "hr-HR",
    "hu": "hu-HU", "it": "it-IT", "ja": "ja-JP", "ko": "ko-KR", "lt": "lt-LT", "lv": "lv-LV",
    "nb": "nb-NO", "nl": "nl-NL", "pl": "pl-PL", "pt": "pt-PT", "ro": "ro-RO", "ru": "ru-RU",
    "sk": "sk-SK", "sl": "sl-SI", "sr": "sr-RS", "sv": "sv-SE", "th": "th-TH", "tr": "tr-TR",
    "uk": "uk-UA", "vi": "vi-VN", "zh": "zh-CN"
  },
  "normalize": [
    { "in": "de", "out": "de" },
    { "in": "DE", "out": "de" },
    { "in": " de_ch ", "out": "de-CH" },
    { "in": "pt-br", "out": "pt-BR" },
    { "in": "en_GB", "out": "en-GB" },
    { "in": "zh-hant", "out": "zh-Hant" },
    { "in": "ZH_HANT_TW", "out": "zh-Hant-TW" },
    { "in": "sr-latn-rs", "out": "sr-Latn-RS" },
    { "in": "es-419", "out": "es-419" },
    { "in": "", "out": "" },
    { "in": "   ", "out": "" }
  ],
  "source": [
    { "in": "en", "out": "en" },
    { "in": "en-US", "out": "en" },
    { "in": "en_gb", "out": "en" },
    { "in": "DE-CH", "out": "de" },
    { "in": "zh-Hant-TW", "out": "zh" },
    { "in": "", "out": "" },
    { "in": "de", "overrides": { "de": "de-CH" }, "out": "de" },
    { "in": "no", "overrides": { "no": "nb-NO" }, "out": "nb" },
    { "in": "no", "overrides": { "no": "  " }, "out": "no" }
  ],
  "target": [
    { "in": "de", "out": "de-DE" },
    { "in": "en", "out": "en-US" },
    { "in": "sl", "out": "sl-SI" },
    { "in": "zh", "out": "zh-CN" },
    { "in": "DE", "out": "de-DE" },
    { "in": "de-CH", "out": "de-CH" },
    { "in": "de_at", "out": "de-AT" },
    { "in": "pt-br", "out": "pt-BR" },
    { "in": "zh-Hant", "out": "zh-Hant" },
    { "in": "es-419", "out": "es-419" },
    { "in": "xx", "out": "xx" },
    { "in": "", "out": "" },
    { "in": "de", "overrides": { "de": "de-CH" }, "out": "de-CH" },
    { "in": "de", "overrides": { "de": "fr" }, "out": "fr-FR" },
    { "in": "de", "overrides": { "de": "" }, "out": "de-DE" },
    { "in": "de", "overrides": { "fr": "fr-CH" }, "out": "de-DE" },
    { "in": "de-at", "overrides": { "de_AT": "de-ch" }, "out": "de-CH" },
    { "in": "no", "overrides": { "no": "nb_no" }, "out": "nb-NO" }
  ],
  "isValid": [
    { "in": "de", "out": true },
    { "in": "de-CH", "out": true },
    { "in": "de_ch", "out": true },
    { "in": "zh-Hant", "out": true },
    { "in": "zh-Hant-TW", "out": true },
    { "in": "es-419", "out": true },
    { "in": "fil", "out": true },
    { "in": "", "out": false },
    { "in": "d", "out": false },
    { "in": "german", "out": false },
    { "in": "de-CHE", "out": false },
    { "in": "de-", "out": false },
    { "in": "de CH", "out": false }
  ]
}
